# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID групповых чатов через запятую (узнать: добавьте бота в группу и отправьте /chatid)
# Пример: -1001234567890,-1009876543210
TELEGRAM_GROUP_CHAT_IDS=-1001234567890

# Время ежедневной отправки саммари (HH:MM), по умолчанию 22:00
SUMMARY_TIME=22:00

# Таймзона для SUMMARY_TIME и отображения времени сообщений
TIMEZONE=Europe/Moscow

# OpenRouter API для LLM-генерации саммари
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель LLM (опционально)
LLM_MODEL=google/gemini-3-flash-preview

# Путь к SQLite-базе (опционально)
# DATABASE_PATH=./data/messages.db
