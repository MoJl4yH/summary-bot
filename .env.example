# =====================================================================
# Telegram Summary Bot — пример конфигурации.
# Скопируйте в .env (cp .env.example .env) и заполните обязательные поля.
# Файл .env содержит секреты: chmod 600 .env, в Git он не попадает.
# =====================================================================

# ---------- Telegram (обязательно) ----------
# Токен бота от @BotFather. Privacy Mode должен быть выключен (/setprivacy → Disable).
TELEGRAM_BOT_TOKEN=
# ID разрешённых групп через запятую. Узнать: добавьте бота в группу и отправьте /chatid.
# Сообщения и команды из других групп игнорируются.
TELEGRAM_GROUP_CHAT_IDS=-1001234567890
# user_id, которым разрешены /summary и /status (узнать — /chatid). Пусто — всем участникам разрешённых групп.
ALLOWED_USER_IDS=
# Не сохранять сообщения других ботов
IGNORE_BOT_MESSAGES=true
# Группа с темами (форум): номер темы для плановых сводок. Пусто — тема General.
# Если General закрыта для участников, укажите открытую тему, иначе сводки не будут опубликованы.
# Номер покажет /chatid, отправленная внутри темы. Для нескольких групп: -100111:5,-100222:9
SUMMARY_THREAD_ID=

# ---------- OpenRouter (обязательно) ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Идентификатор модели из каталога https://openrouter.ai/models
LLM_MODEL=google/gemini-3-flash-preview
LLM_TEMPERATURE=0.2
# Максимум выходных токенов одного ответа
LLM_MAX_OUTPUT_TOKENS=4000
# Сетевой тайм-аут одного запроса, секунд
LLM_TIMEOUT_SECONDS=120
# Повторы при 429/5xx/сетевых ошибках (экспоненциальная задержка, учитывается Retry-After)
LLM_MAX_RETRIES=4
# Повторы, если модель вернула JSON, не прошедший проверку схемы
LLM_INVALID_JSON_RETRIES=1

# ---------- Контроль объёма и расходов ----------
# Размер одного фрагмента переписки в запросе к LLM (символы). Длиннее — многоэтапное суммирование.
LLM_CHUNK_MAX_CHARS=60000
# Максимальный объём переписки на одну сводку (символы); при превышении берутся самые новые сообщения
LLM_MAX_INPUT_CHARS=400000
# Жёсткий лимит обращений к LLM на одну сводку
LLM_MAX_CALLS_PER_SUMMARY=12
# Лимит расходов OpenRouter за скользящие 24 часа, USD (0 — без лимита)
LLM_DAILY_BUDGET_USD=1.00
# Длина одного сообщения, передаваемого модели (длиннее — обрезается)
MAX_MESSAGE_CHARS=2000

# ---------- Расписание ----------
TIMEZONE=Europe/Moscow

DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME=22:00

WEEKLY_SUMMARY_ENABLED=true
# monday..sunday (или 1..7, или по-русски: воскресенье)
WEEKLY_SUMMARY_DAY=sunday
WEEKLY_SUMMARY_TIME=23:00

# Пропущенная (из-за простоя) сводка публикуется, если с момента запуска прошло не больше N часов
MISSED_SUMMARY_MAX_DELAY_HOURS=12
# Сколько раз повторять неудавшуюся плановую сводку (интервалы 5, 10, 20, 40... мин, максимум 60)
SCHEDULED_SUMMARY_MAX_ATTEMPTS=5

# ---------- Сводки ----------
# Ручные сводки: не чаще одной успешной на группу за интервал (секунды)
MANUAL_SUMMARY_COOLDOWN_SECONDS=3600
# Минимум сообщений за период; меньше — LLM не вызывается
MIN_MESSAGES_FOR_SUMMARY=5
# Публиковать короткое уведомление, если для плановой сводки мало сообщений (false — молча пропустить)
POST_EMPTY_AUTO_SUMMARY=false

# ---------- Хранение ----------
# Срок хранения исходных сообщений, дней (не меньше 8 — нужны для еженедельной сводки)
MESSAGE_RETENTION_DAYS=30
# Ежедневная резервная копия БД в /data/backups и сколько копий хранить
BACKUP_ENABLED=true
BACKUP_KEEP=7
# Для запуска без Docker (в контейнере путь фиксирован: /data/bot.db)
# DATABASE_PATH=./data/messages.db

# ---------- Журналирование ----------
LOG_LEVEL=INFO
